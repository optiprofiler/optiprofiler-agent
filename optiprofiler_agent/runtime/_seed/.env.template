# ============================================================================
# OptiProfiler Agent — User-level secrets (seed template)
#
# This template is copied to ~/.opagent/.env on first run.  It is NEVER
# overwritten by `pip install --upgrade`, so keys you fill in survive
# package upgrades.
#
# Recommended: run `opagent init` and let the wizard write this file.
# Hand-editing also works — uncomment the provider you use, paste the
# key, and save.
#
# Precedence (highest → lowest):
#   1. Shell export          (export FOO=...)
#   2. ./.env                (project-local override)
#   3. THIS FILE             (~/.opagent/.env, user-level)
#   4. PROVIDER_REGISTRY     (built-in defaults in config.py)
#
# After saving, optionally restrict permissions:
#     chmod 600 ~/.opagent/.env
# ============================================================================

# --- Default provider --------------------------------------------------------
# Allowed: minimax | kimi | openai | deepseek | mimo | anthropic | custom
# OPAGENT_DEFAULT_PROVIDER=minimax

# --- Built-in providers (uncomment the one you use) --------------------------
# MINIMAX_API_KEY=your-minimax-key-here
# KIMI_API_KEY=sk-your-kimi-key-here
# OPENAI_API_KEY=sk-your-openai-key-here
# DEEPSEEK_API_KEY=sk-your-deepseek-key-here
# MIMO_API_KEY=sk-your-mimo-key-here
# ANTHROPIC_API_KEY=sk-ant-your-anthropic-key-here   # requires `pip install 'optiprofiler-agent[anthropic]'`

# --- Optional: pin a specific model (overrides registry default) -------------
# OPAGENT_DEFAULT_MODEL=deepseek-v4-pro

# --- Optional: route all requests through a proxy ----------------------------
# OPAGENT_DEFAULT_BASE_URL=https://my-corp-proxy.example.com/v1

# --- Custom OpenAI-compatible endpoint (any unlisted vendor / self-hosted) ---
# Set OPAGENT_DEFAULT_PROVIDER=custom above, then fill all three:
# OPAGENT_CUSTOM_BASE_URL=https://api.example.com/v1
# OPAGENT_CUSTOM_MODEL=your-model-name
# OPAGENT_CUSTOM_API_KEY=sk-your-key-here

# --- Tavily web search (optional; for web_search tool) -----------------------
# TAVILY_API_KEY=tvly-your-tavily-key-here
